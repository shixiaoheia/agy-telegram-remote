# 示例，不是实际凭据。自动安装时无需手动编辑此文件。
# 安装后的真实配置位置：/etc/agy-telegram-remote/config.env
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
ALLOWED_USER_IDS=replace_with_your_numeric_telegram_id

AGY_PATH=/root/.local/bin/agy
AGY_HOME=/root
AGY_WORKSPACE=/root
AGY_TIMEOUT_SECONDS=900
MAX_PROMPT_CHARS=12000
MAX_OUTPUT_BYTES=1048576
MAX_REPLY_CHARS=30000

# 新安装默认 true；普通升级保留旧设置。
# 自动审批不等于完整沙箱，也不等于只有工作目录可以被读取。
AGY_SKIP_PERMISSIONS=true

# 额外可写应用目录；逗号分隔，默认留空。由安装器 --write-paths 设置并重建服务。
# 例：AGY_WRITE_PATHS=/etc/nginx,/opt/my-app（目录必须已存在且不是符号链接）
# 只编辑 config.env 并重启 bot 不会更新 systemd 的 ReadWritePaths。
AGY_WRITE_PATHS=''
# full：以主机 root 权限执行，不启用本项目的 systemd 文件系统与能力限制。
# 安装器 --full-host-access 同时开启自动审批；普通升级保留此设置。
AGY_HOST_ACCESS=restricted

STATE_DIR=/var/lib/agy-telegram-remote
RESULT_RETENTION_DAYS=7

# 可选：默认模型（留空由 agy 决定；白名单用户可在 Telegram 中用 /model 动态切换）
# AGY_MODEL=gemini-3.8-flash-high
