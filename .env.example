# Required: get this from @BotFather. Never commit a real token.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Only the listed numeric Telegram IDs can submit tasks. Separate multiple IDs with commas.
ALLOWED_USER_IDS=123456789

# Use absolute paths because systemd does not load your interactive shell PATH.
AGY_PATH=/home/agy-tg/.local/bin/agy
AGY_WORKSPACE=/srv/agy-workspace

# One task may run for up to 15 minutes.
AGY_TIMEOUT_SECONDS=900
MAX_PROMPT_CHARS=12000

# Protect the bot and your chat from excessive command output.
MAX_OUTPUT_BYTES=1048576
MAX_REPLY_CHARS=30000

# false is the safer default. Set true only if you trust every allowed user,
# the isolated workspace, and want agy to auto-approve command/file tools.
AGY_SKIP_PERMISSIONS=false
